{
  "name": "eduagent",
  "private": true,
  "scripts": {
    "eduagent": "pnpm --silent --filter @eduagent/launcher exec tsx src/main.ts",
    "build": "pnpm --filter @eduagent/visualiser build",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "biome check && pnpm --filter @eduagent/visualiser --filter @eduagent/edupi --filter @eduagent/launcher test",
    "test:e2e": "pnpm --filter @eduagent/visualiser test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2"
  }
}
