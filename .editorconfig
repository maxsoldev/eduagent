# Matches biome.jsonc (TypeScript, JavaScript) and [tool.ruff] in backends/educodex/pyproject.toml (Python).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,mjs,cjs}]
indent_style = tab
indent_size = 3
max_line_length = 120

[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{json,jsonl,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[backends/educodex/src/educodex/vendor/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
